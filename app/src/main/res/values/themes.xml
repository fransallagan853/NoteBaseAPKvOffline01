<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema Mode Terang -->
    <style
        name="Base.Theme.NoteBaseAPK"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorOnPrimary">@color/black_bg</item>

        <item name="colorSurface">@color/charcoal_bg</item>
        <item name="colorOnSurface">@color/white_text</item>

        <item name="android:windowBackground">@color/black_bg</item>
        <item name="android:statusBarColor">@color/black_bg</item>
        <item name="android:navigationBarColor">@color/charcoal_bg</item>

        <item name="android:windowLightStatusBar">true</item>
        <item
            name="android:windowLightNavigationBar"
            tools:targetApi="27">
            true
        </item>
    </style>

    <style
        name="Theme.NoteBaseAPK"
        parent="Base.Theme.NoteBaseAPK" />

    <style
        name="CompactEditText"
        parent="Widget.Material3.TextInputEditText.OutlinedBox">

        <item name="android:textColor">@color/white_text</item>
        <item name="android:textColorHint">@color/gray_text</item>
        <item name="boxStrokeColor">@color/cyan_accent</item>
        <item name="hintTextColor">@color/cyan_accent</item>
    </style>

    <!-- Custom Keyboard Styles -->
    <style
        name="KeyboardBtnBase"
        parent="Widget.Material3.Button.TextButton">

        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:padding">0dp</item>

        <item name="android:background">@drawable/bg_keyboard_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>

        <item name="android:textColor">@color/white_text</item>

        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style
        name="KeyboardBtnNumeric"
        parent="KeyboardBtnBase">

        <item name="android:layout_weight">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style
        name="KeyboardBtnAlpha"
        parent="KeyboardBtnBase">

        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style
        name="KeyboardBtnAction"
        parent="KeyboardBtnBase">

        <item name="android:textSize">14sp</item>
    </style>

</resources>