<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Saat tombol ditekan -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A46" />
            <stroke
                android:width="1dp"
                android:color="@color/cyan_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151A1F" />
            <stroke
                android:width="1dp"
                android:color="#2A3A42" />
            <corners android:radius="8dp" />
        </shape>
    </item>

</selector>