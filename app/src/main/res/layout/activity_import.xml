<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white_text"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Import Data"
                android:textColor="@color/white_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Pilih / Upload File"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <LinearLayout
                android:id="@+id/btnSelectFile"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/stat_sys_upload"
                    app:tint="@color/cyan_accent" />

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pilih File CSV"
                    android:textColor="@color/white_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMapping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Mapping Kolom"
                    android:textColor="@color/cyan_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sesuaikan kolom dari file Anda dengan data noteBase."
                    android:textColor="@color/gray_text"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:stretchColumns="1">
                    
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="No. Polisi *" android:textColor="@color/white_text" android:paddingEnd="12dp"/>
                        <Spinner android:id="@+id/spNopol" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/cyan_accent" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Kendaraan" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spNama" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Tahun" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spTahun" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Warna" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spWarna" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="No Rangka" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spRangka" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="No Mesin" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spMesin" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Leasing" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spLeasing" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Saldo" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spSaldo" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Overdue / OVD" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spOverdue" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                    <TableRow android:layout_marginBottom="8dp">
                        <TextView android:text="Catatan" android:textColor="@color/white_text" />
                        <Spinner android:id="@+id/spCatatan" android:layout_width="match_parent" android:layout_height="wrap_content" android:backgroundTint="@color/white_text" />
                    </TableRow>
                </TableLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="3. Preview Data"
                    android:textColor="@color/cyan_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_item_rounded"
                    android:backgroundTint="#0DFFFFFF"
                    android:padding="12dp"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp"
                    android:text="Preview data akan muncul di sini..." />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Opsi Import"
                    android:textColor="@color/gray_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />

                <RadioGroup
                    android:id="@+id/rgLeasingMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">
                    <RadioButton
                        android:id="@+id/rbAuto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Otomatis dari file"
                        android:textColor="@color/white_text"
                        android:buttonTint="@color/cyan_accent"
                        android:checked="true" />
                    <RadioButton
                        android:id="@+id/rbManual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gunakan leasing pilihan"
                        android:textColor="@color/white_text"
                        android:buttonTint="@color/cyan_accent" />
                </RadioGroup>

                <EditText
                    android:id="@+id/etLeasingManual"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_item_rounded"
                    android:hint="Ketik nama leasing..."
                    android:inputType="textCapWords"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/white_text"
                    android:textColorHint="@color/gray_text"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartImport"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="32dp"
                    android:text="Mulai Import"
                    android:textColor="@color/black_bg"
                    android:textStyle="bold"
                    app:backgroundTint="@color/cyan_accent"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Status Import"
                    android:textColor="@color/gray_text"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:progressTint="@color/cyan_accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvResult"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white_text"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:background="@color/charcoal_bg"
        android:elevation="12dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/gray_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Beranda"
                android:textColor="@color/gray_text"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuImport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_import"
                app:tint="@color/cyan_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Import"
                android:textColor="@color/cyan_accent"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/gray_text" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Pengaturan"
                android:textColor="@color/gray_text"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

</androidx.constraintlayout.widget.ConstraintLayout>
