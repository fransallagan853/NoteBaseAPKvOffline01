<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black_bg"
    android:orientation="vertical"
    android:padding="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Baris 1: Q W E R T Y U I O P -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnQ" style="@style/KeyboardBtnAlpha" android:text="Q" android:focusable="false" />
        <Button android:id="@+id/btnW" style="@style/KeyboardBtnAlpha" android:text="W" android:focusable="false" />
        <Button android:id="@+id/btnE" style="@style/KeyboardBtnAlpha" android:text="E" android:focusable="false" />
        <Button android:id="@+id/btnR" style="@style/KeyboardBtnAlpha" android:text="R" android:focusable="false" />
        <Button android:id="@+id/btnT" style="@style/KeyboardBtnAlpha" android:text="T" android:focusable="false" />
        <Button android:id="@+id/btnY" style="@style/KeyboardBtnAlpha" android:text="Y" android:focusable="false" />
        <Button android:id="@+id/btnU" style="@style/KeyboardBtnAlpha" android:text="U" android:focusable="false" />
        <Button android:id="@+id/btnI" style="@style/KeyboardBtnAlpha" android:text="I" android:focusable="false" />
        <Button android:id="@+id/btnO" style="@style/KeyboardBtnAlpha" android:text="O" android:focusable="false" />
        <Button android:id="@+id/btnP" style="@style/KeyboardBtnAlpha" android:text="P" android:focusable="false" />
    </LinearLayout>

    <!-- Baris 2: A S D F G H J K L -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">
        <Button android:id="@+id/btnA" style="@style/KeyboardBtnAlpha" android:text="A" android:focusable="false" />
        <Button android:id="@+id/btnS" style="@style/KeyboardBtnAlpha" android:text="S" android:focusable="false" />
        <Button android:id="@+id/btnD" style="@style/KeyboardBtnAlpha" android:text="D" android:focusable="false" />
        <Button android:id="@+id/btnF" style="@style/KeyboardBtnAlpha" android:text="F" android:focusable="false" />
        <Button android:id="@+id/btnG" style="@style/KeyboardBtnAlpha" android:text="G" android:focusable="false" />
        <Button android:id="@+id/btnH" style="@style/KeyboardBtnAlpha" android:text="H" android:focusable="false" />
        <Button android:id="@+id/btnJ" style="@style/KeyboardBtnAlpha" android:text="J" android:focusable="false" />
        <Button android:id="@+id/btnK" style="@style/KeyboardBtnAlpha" android:text="K" android:focusable="false" />
        <Button android:id="@+id/btnL" style="@style/KeyboardBtnAlpha" android:text="L" android:focusable="false" />
    </LinearLayout>

    <!-- Baris 3: Z X C V B N M [SEARCH] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnZ" style="@style/KeyboardBtnAlpha" android:text="Z" android:focusable="false" />
        <Button android:id="@+id/btnX" style="@style/KeyboardBtnAlpha" android:text="X" android:focusable="false" />
        <Button android:id="@+id/btnC" style="@style/KeyboardBtnAlpha" android:text="C" android:focusable="false" />
        <Button android:id="@+id/btnV" style="@style/KeyboardBtnAlpha" android:text="V" android:focusable="false" />
        <Button android:id="@+id/btnB" style="@style/KeyboardBtnAlpha" android:text="B" android:focusable="false" />
        <Button android:id="@+id/btnN" style="@style/KeyboardBtnAlpha" android:text="N" android:focusable="false" />
        <Button android:id="@+id/btnM" style="@style/KeyboardBtnAlpha" android:text="M" android:focusable="false" />
        <Button
            android:id="@+id/btnSearch"
            style="@style/KeyboardBtnAction"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:text="SEARCH"
            android:textColor="@color/cyan_accent"
            android:textStyle="bold"
            android:focusable="false" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:layout_marginVertical="4dp" />

    <!-- Baris 4: 1 2 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btn1" style="@style/KeyboardBtnNumeric" android:text="1" android:focusable="false" />
        <Button android:id="@+id/btn2" style="@style/KeyboardBtnNumeric" android:text="2" android:focusable="false" />
        <Button android:id="@+id/btn3" style="@style/KeyboardBtnNumeric" android:text="3" android:focusable="false" />
    </LinearLayout>

    <!-- Baris 5: 4 5 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btn4" style="@style/KeyboardBtnNumeric" android:text="4" android:focusable="false" />
        <Button android:id="@+id/btn5" style="@style/KeyboardBtnNumeric" android:text="5" android:focusable="false" />
        <Button android:id="@+id/btn6" style="@style/KeyboardBtnNumeric" android:text="6" android:focusable="false" />
    </LinearLayout>

    <!-- Baris 6: 7 8 9 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btn7" style="@style/KeyboardBtnNumeric" android:text="7" android:focusable="false" />
        <Button android:id="@+id/btn8" style="@style/KeyboardBtnNumeric" android:text="8" android:focusable="false" />
        <Button android:id="@+id/btn9" style="@style/KeyboardBtnNumeric" android:text="9" android:focusable="false" />
    </LinearLayout>

    <!-- Baris 7: [X] 0 [←] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">
        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_keyboard_button"
            android:src="@drawable/ic_clear_circle"
            android:scaleType="center"
            android:focusable="false"
            app:tint="@color/red_delete" />
        <Button android:id="@+id/btn0" style="@style/KeyboardBtnNumeric" android:text="0" android:focusable="false" />
        <ImageButton
            android:id="@+id/btnBackspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/bg_keyboard_button"
            android:src="@drawable/ic_backspace_keyboard"
            android:scaleType="center"
            android:focusable="false"
            app:tint="@color/white_text" />
    </LinearLayout>

</LinearLayout>
