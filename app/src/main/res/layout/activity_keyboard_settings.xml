<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:layout_marginTop="36dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Pengaturan Keyboard"
                android:textColor="@color/white_text"
                android:textSize="20sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tampilan Keyboard"
                android:textColor="@color/cyan_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pilih layout keyboard untuk pencarian utama"
                android:textColor="@color/gray_text"
                android:textSize="14sp" />

            <RadioGroup
                android:id="@+id/rgKeyboardLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <RadioButton
                    android:id="@+id/rbDefault"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Default noteBase"
                    android:textColor="@color/white_text"
                    android:buttonTint="@color/cyan_accent" />

                <RadioButton
                    android:id="@+id/rbQwertyNumpad"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="QWERTY + Numpad"
                    android:textColor="@color/white_text"
                    android:buttonTint="@color/cyan_accent" />

                <RadioButton
                    android:id="@+id/rbNumpadTop"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Numpad Atas"
                    android:textColor="@color/white_text"
                    android:buttonTint="@color/cyan_accent" />

                <RadioButton
                    android:id="@+id/rbNumpadBottom"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Numpad Bawah"
                    android:textColor="@color/white_text"
                    android:buttonTint="@color/cyan_accent" />

                <RadioButton
                    android:id="@+id/rbCustomManual"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Custom Manual"
                    android:textColor="@color/white_text"
                    android:buttonTint="@color/cyan_accent" />

            </RadioGroup>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_margin="16dp"
        android:text="Simpan Perubahan"
        android:textColor="@color/black_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cyan_accent"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
