<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white_text" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Tambah Data"
            android:textColor="@color/white_text"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnSave"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nomor Polisi"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNopol"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="Contoh: B 6372 EDC"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nama Kendaraan / Type"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNamaKendaraan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="Contoh: Toyota Fortuner"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tahun"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etTahun"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_item_rounded"
                        android:hint="2023"
                        android:inputType="number"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white_text"
                        android:textColorHint="@color/gray_text" />

                </LinearLayout>

                <View
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warna"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etWarna"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_item_rounded"
                        android:hint="HITAM"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white_text"
                        android:textColorHint="@color/gray_text" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Leasing"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etLeasing"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="Contoh: ADIRA"
                android:inputType="textCapWords"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Cabang"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCabang"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="Contoh: JABAR / DEPOK / BEKASI"
                android:inputType="textCapCharacters"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etSaldo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_item_rounded"
                        android:hint="Rp 0"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white_text"
                        android:textColorHint="@color/gray_text" />

                </LinearLayout>

                <View
                    android:layout_width="16dp"
                    android:layout_height="0dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Overdue / OVD"
                        android:textColor="@color/gray_text"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etOverdue"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_item_rounded"
                        android:hint="30 Hari"
                        android:inputType="text"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/white_text"
                        android:textColorHint="@color/gray_text" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="No Rangka"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNoRangka"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="MHKE8FB..."
                android:inputType="textCapCharacters|textNoSuggestions"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="No Mesin"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etNoMesin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:hint="2NR4E2..."
                android:inputType="textCapCharacters|textNoSuggestions"
                android:paddingHorizontal="16dp"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Catatan"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_item_rounded"
                android:gravity="top|start"
                android:hint="Catatan tambahan..."
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="120dp"
                android:padding="16dp"
                android:scrollbars="vertical"
                android:textColor="@color/white_text"
                android:textColorHint="@color/gray_text" />

            <!-- Visibilitas data sementara dinonaktifkan -->

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="Simpan"
        android:textAllCaps="false"
        android:textColor="@color/black_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cyan_accent"
        app:cornerRadius="8dp"
        app:icon="@drawable/ic_save"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconTint="@color/black_bg"
        app:layout_constraintBottom_toTopOf="@id/keyboardContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/keyboardContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/black_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>